rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function isActiveStaff() {
      return userExists()
        && currentUser().isActive == true
        && currentUser().role in ['admin', 'employee'];
    }

    function isAdmin() {
      return isActiveStaff() && currentUser().role == 'admin';
    }

    // Own profile: readable without circular get() dependency
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isActiveStaff()
      );
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role in ['admin', 'employee']
          && request.resource.data.isActive == true
        );
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    match /livreurs/{docId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff();
      allow delete: if isAdmin();
    }

    match /stock/{docId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff();
      allow delete: if isAdmin();
    }

    match /deliveries/{docId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff();
      allow delete: if isAdmin();
    }

    match /partners/{docId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff();
      allow delete: if isAdmin();
    }
  }
}
